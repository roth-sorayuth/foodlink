PORT=5000

# Supabase Postgres Connection String
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Allowed Frontend Origins for CORS & WebSockets
CLIENT_ORIGIN_CUSTOMER="http://localhost:5173"
CLIENT_ORIGIN_MERCHANT="http://localhost:5174"

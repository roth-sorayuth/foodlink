# FoodLink Customer App Environment Configuration
# Copy this file to .env and adjust values for local or production deployment

# Frontend Portal URLs
VITE_CUSTOMER_URL="http://localhost:5173"
VITE_MERCHANT_URL="http://localhost:5174"

# Backend REST API endpoint (Express server)
VITE_API_URL="http://localhost:5000/api"

# Backend Socket.io Real-Time Gateway endpoint
VITE_SOCKET_URL="http://localhost:5000"

# Optional App Metadata
VITE_APP_NAME="FoodLink Customer"
